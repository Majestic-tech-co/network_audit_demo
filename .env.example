# ─── NetAudit Environment Configuration ───────────────────────────
# Copy this file to .env and fill in your values before running.
# NEVER commit .env to version control.

# ─── Database ─────────────────────────────────────────────────────
POSTGRES_DB=netaudit
POSTGRES_USER=netaudit
POSTGRES_PASSWORD=change-this-strong-password

# ─── Redis ────────────────────────────────────────────────────────
REDIS_PASSWORD=change-this-redis-password

# ─── Security ─────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
SECRET_KEY=change-this-secret-key-in-production
# Must be exactly 32 characters for AES-256
ENCRYPTION_KEY=change-this-encryption-key-32chars

# ─── Network ──────────────────────────────────────────────────────
HTTP_PORT=80
HTTPS_PORT=443
# Explicit origins only (the app is served same-origin via nginx; this is a backstop). Never *.
CORS_ORIGINS=https://yourdomain.com
VITE_API_URL=/api
VITE_WS_URL=/ws

# ─── Cloudflare Turnstile (CAPTCHA on login/register; free tier) ──
# Leave blank to disable. SECRET stays on the server; SITE key is embedded in the frontend build.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ─── AI Providers (configured per-org via admin UI, but defaults here) ─
# Leave blank — configured through the admin panel
DEFAULT_AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama:11434

# ─── Optional: VirusTotal (hash lookups only, no file upload) ──────
VIRUSTOTAL_API_KEY=

# ─── Optional: LDAP / Active Directory ────────────────────────────
LDAP_ENABLED=false
LDAP_SERVER=ldap://your-ad-server
LDAP_BASE_DN=dc=company,dc=com
LDAP_BIND_DN=cn=netaudit,ou=service-accounts,dc=company,dc=com
LDAP_BIND_PASSWORD=

# ─── Notifications ────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=netaudit@yourcompany.com

SLACK_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=

# ─── Data retention (days; 0 = keep forever) ─────────────────────
# Purged daily. Fill in the same periods in the privacy notice (/privacy).
RETENTION_SCAN_DAYS=180      # finished scans, their findings and raw nmap output
RETENTION_CAPTURE_DAYS=7     # packet captures (.pcap)
RETENTION_DEVICE_DAYS=365    # devices not seen since, with no remaining findings

# ─── Environment ──────────────────────────────────────────────────
ENVIRONMENT=production
