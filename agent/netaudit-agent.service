[Unit]
Description=NetAudit Security Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/netaudit-agent/agent.py start
Restart=on-failure
RestartSec=30
User=netaudit-agent
Group=netaudit-agent
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
